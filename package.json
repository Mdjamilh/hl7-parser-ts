{
  "name": "hl7-parser-ts",
  "version": "0.1.0",
  "description": "Zero-dependency HL7 v2 parser, query and serializer for TypeScript.",
  "license": "MIT",
  "author": "Md. Jamil Hossain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mdjamilh/hl7-parser-ts.git"
  },
  "keywords": [
    "hl7",
    "hl7v2",
    "healthcare",
    "parser",
    "mllp",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "hl7": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsup",
    "prepublishOnly": "npm run build && npm test",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "tsup"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.8",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  }
}
